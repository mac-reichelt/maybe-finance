<%= render DS::Dialog.new do |dialog| %>
  <div class="flex flex-col relative">
    <div class="border-b border-tertiary md:border-alpha-black-25 px-4 pb-4 text-gray-800 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="text-primary">Connect via SimpleFIN</span>
      </div>
      <%= icon("x", as_button: true, size: "lg", data: { action: "dialog#close" }) %>
    </div>

    <div class="p-4">
      <p class="text-sm text-secondary mb-4">
        To connect your bank accounts via SimpleFIN, you'll need a setup token from
        <a href="https://bridge.simplefin.org" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">SimpleFIN Bridge</a>.
        Sign up there, connect your bank, and paste the setup token below.
      </p>

      <%= form_with url: simplefin_items_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :name, "Connection name (optional)", class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.text_field :name,
                name: "simplefin_item[name]",
                placeholder: "My Bank",
                class: "w-full rounded-lg border border-alpha-black-100 bg-white px-3 py-2 text-sm placeholder:text-secondary focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :setup_token, "Setup token", class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.text_area :setup_token,
                name: "simplefin_item[setup_token]",
                required: true,
                rows: 3,
                placeholder: "Paste your SimpleFIN setup token here...",
                class: "w-full rounded-lg border border-alpha-black-100 bg-white px-3 py-2 text-sm placeholder:text-secondary focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent font-mono" %>
        </div>

        <div class="flex justify-end">
          <%= f.submit "Connect", class: "inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-500 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
