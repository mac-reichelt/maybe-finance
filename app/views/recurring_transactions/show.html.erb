<%= render DS::Dialog.new(variant: "drawer") do |dialog| %>
  <% dialog.with_header do %>
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full flex items-center justify-center bg-container-inset">
          <% if @recurring_transaction.subscription? %>
            <%= icon("credit-card", size: "sm") %>
          <% else %>
            <%= icon("repeat", size: "sm") %>
          <% end %>
        </div>
        <div>
          <h2 class="text-primary font-medium"><%= @recurring_transaction.title %></h2>
          <% if @recurring_transaction.auto_detected? %>
            <p class="text-xs text-secondary">Auto-detected &middot; <%= number_to_percentage(@recurring_transaction.confidence_score.to_f * 100, precision: 0) %> confidence</p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% dialog.with_body do %>
    <% dialog.with_section(title: "Overview", open: true) do %>
      <div class="pb-4">
        <%= styled_form_with model: @recurring_transaction,
              url: recurring_transaction_path(@recurring_transaction),
              class: "space-y-2",
              data: { controller: "auto-submit-form" } do |f| %>

          <%= f.text_field :title,
                label: "Name",
                "data-auto-submit-form-target": "auto" %>

          <div class="flex items-center gap-2">
            <%= f.number_field :amount,
                  label: "Amount",
                  step: 0.01,
                  min: 0,
                  container_class: "w-2/3",
                  "data-auto-submit-form-target": "auto" %>
            <%= f.text_field :currency,
                  label: "Currency",
                  container_class: "w-1/3",
                  disabled: true %>
          </div>

          <%= f.select :frequency,
                RecurringTransaction::FREQUENCIES.map { |fv| [fv.humanize, fv] },
                { label: "Frequency", include_blank: false },
                "data-auto-submit-form-target": "auto" %>

          <div class="flex items-center gap-2">
            <%= f.date_field :start_date,
                  label: "Start Date",
                  container_class: "w-1/2",
                  "data-auto-submit-form-target": "auto" %>
            <%= f.date_field :next_expected_date,
                  label: "Next Expected",
                  container_class: "w-1/2",
                  "data-auto-submit-form-target": "auto" %>
          </div>

        <% end %>
      </div>
    <% end %>

    <% dialog.with_section(title: "Details") do %>
      <div class="pb-4">
        <%= styled_form_with model: @recurring_transaction,
              url: recurring_transaction_path(@recurring_transaction),
              class: "space-y-2",
              data: { controller: "auto-submit-form" } do |f| %>

          <%= f.collection_select :category_id,
                Current.family.categories.alphabetically,
                :id, :name,
                { include_blank: "None", label: "Category" },
                "data-auto-submit-form-target": "auto" %>

          <%= f.collection_select :merchant_id,
                Current.family.assigned_merchants.alphabetically,
                :id, :name,
                { include_blank: "None", label: "Merchant" },
                "data-auto-submit-form-target": "auto" %>

          <div class="flex cursor-pointer items-center gap-4 justify-between py-2">
            <div class="text-sm space-y-1">
              <h4 class="text-primary">Subscription</h4>
              <p class="text-secondary">Mark this as a subscription service</p>
            </div>
            <%= f.check_box :is_subscription,
                  class: "toggle",
                  "data-auto-submit-form-target": "auto" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% dialog.with_section(title: "Settings") do %>
      <div class="pb-4 space-y-4">
        <% if @recurring_transaction.active? %>
          <div class="flex items-center justify-between gap-4 p-3">
            <div class="text-sm space-y-1">
              <h4 class="text-primary">Pause</h4>
              <p class="text-secondary">Temporarily pause this recurring transaction</p>
            </div>
            <%= render DS::Button.new(
              text: "Pause",
              variant: "outline",
              href: recurring_transaction_path(@recurring_transaction, recurring_transaction: { status: "paused" }),
              method: :patch
            ) %>
          </div>
        <% elsif @recurring_transaction.status == "paused" %>
          <div class="flex items-center justify-between gap-4 p-3">
            <div class="text-sm space-y-1">
              <h4 class="text-primary">Resume</h4>
              <p class="text-secondary">Resume this recurring transaction</p>
            </div>
            <%= render DS::Button.new(
              text: "Resume",
              variant: "primary",
              href: recurring_transaction_path(@recurring_transaction, recurring_transaction: { status: "active" }),
              method: :patch
            ) %>
          </div>
        <% end %>

        <div class="flex items-center justify-between gap-4 p-3">
          <div class="text-sm space-y-1">
            <h4 class="text-primary">Delete</h4>
            <p class="text-secondary">Permanently remove this recurring transaction</p>
          </div>
          <%= render DS::Button.new(
            text: "Delete",
            variant: "outline-destructive",
            href: recurring_transaction_path(@recurring_transaction),
            method: :delete,
            confirm: CustomConfirm.for_resource_deletion("recurring transaction"),
            frame: "_top"
          ) %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
