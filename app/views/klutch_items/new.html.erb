<%= render DS::Dialog.new do |dialog| %>
  <div class="flex flex-col relative">
    <div class="border-b border-tertiary md:border-alpha-black-25 px-4 pb-4 text-gray-800 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="text-primary">Connect via Klutch Card</span>
      </div>
      <%= icon("x", as_button: true, size: "lg", data: { action: "dialog#close" }) %>
    </div>

    <div class="p-4">
      <p class="text-sm text-secondary mb-4">
        Connect your Klutch Card account to automatically import transactions.
        You'll need your API endpoint, client ID, and secret key from Klutch.
      </p>

      <%= form_with url: klutch_items_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :name, "Connection name (optional)", class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.text_field :name,
                name: "klutch_item[name]",
                placeholder: "My Klutch Card",
                class: "w-full rounded-lg border border-alpha-black-100 bg-white px-3 py-2 text-sm placeholder:text-secondary focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        </div>

        <div>
          <%= f.label :endpoint, "API Endpoint", class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.url_field :endpoint,
                name: "klutch_item[endpoint]",
                required: true,
                placeholder: "https://api.klutchcard.com/graphql",
                class: "w-full rounded-lg border border-alpha-black-100 bg-white px-3 py-2 text-sm placeholder:text-secondary focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent font-mono" %>
        </div>

        <div>
          <%= f.label :client_id, "Client ID", class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.text_field :client_id,
                name: "klutch_item[client_id]",
                required: true,
                placeholder: "Your Klutch client ID",
                class: "w-full rounded-lg border border-alpha-black-100 bg-white px-3 py-2 text-sm placeholder:text-secondary focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent font-mono" %>
        </div>

        <div>
          <%= f.label :secret_key, "Secret Key", class: "block text-sm font-medium text-primary mb-1" %>
          <%= f.password_field :secret_key,
                name: "klutch_item[secret_key]",
                required: true,
                placeholder: "Your Klutch secret key",
                class: "w-full rounded-lg border border-alpha-black-100 bg-white px-3 py-2 text-sm placeholder:text-secondary focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent font-mono" %>
        </div>

        <div class="flex justify-end">
          <%= f.submit "Connect", class: "inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-500 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
